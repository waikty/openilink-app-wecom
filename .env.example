# OpeniLink Hub 配置（必填）
HUB_URL=https://hub.example.com
BASE_URL=https://your-app.example.com

# 企业微信智能机器人（必填）
WECOM_BOT_ID=your-bot-id
WECOM_BOT_SECRET=your-bot-secret

# 企业微信自建应用（可选，用于 OpenAPI）
WECOM_CORP_ID=
WECOM_CORP_SECRET=

# 服务配置（可选）
PORT=8085
DB_PATH=data/wecom.db

# 统一 Digital Life 入站（四项必须同时配置；不配置时 fail-closed，不回退 Hub AI）
# 使用同一 AstrBot webhook UUID 对应的私网地址；Docker 同网络时可用服务名
LANVIA_DIGITAL_LIFE_WEBHOOK_URL=http://astrbot:6185/api/platform/webhook/your-astrbot-webhook-uuid
LANVIA_SOCIAL_TENANT_ID=your-core-tenant-id
LANVIA_SOCIAL_CHANNEL=wecom_bot
LANVIA_SOCIAL_ACCOUNT_ID=your-bot-id

# 推荐挂载 Docker secret 文件，不要把真实密钥写入仓库或普通 .env
LANVIA_SOCIAL_BRIDGE_SECRET_FILE=/run/secrets/lanvia-social-bridge.key
# 本地开发可临时使用至少 32 字节的随机值：
# LANVIA_SOCIAL_BRIDGE_SECRET=replace-with-a-random-secret-at-least-32-bytes
